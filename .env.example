# ── Base ─────────────────────────────────────────────
NODE_ENV=development
APP_URL=http://localhost:3100
DATABASE_URL=postgresql://mih:mih_dev_password@localhost:5442/mih
# Opcional. Sem Redis, as sincronizações e relatórios correm de forma síncrona a pedido.
REDIS_URL=redis://localhost:6392

# Chave de encriptação dos tokens OAuth (32 bytes em base64).
# Gerar: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=
# Segredo para assinar cookies de estado OAuth e hashes (mín. 32 caracteres).
SESSION_SECRET=

# Utilizador inicial criado pelo seed (altere a password após o primeiro login).
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Administrador
# true = o seed cria 3 clientes de demonstração com dados SIMULADOS.
SEED_DEMO=true

# ── Google (Ads, Search Console, GA4) ────────────────
# Consola Google Cloud → OAuth client "Web application".
# Redirect URI autorizado: ${APP_URL}/api/oauth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Google Ads API Center (conta gestora). Necessário para a Google Ads API.
GOOGLE_ADS_DEVELOPER_TOKEN=
# Opcional: ID da conta gestora (MCC) sem hífenes, usado como login-customer-id.
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_API_VERSION=v26

# ── Meta (Marketing API) ─────────────────────────────
# developers.facebook.com → App → Facebook Login. Redirect: ${APP_URL}/api/oauth/meta/callback
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v25.0

# ── SEO de terceiros (opcional) ──────────────────────
SEMRUSH_API_KEY=
SEMRUSH_DATABASE=pt

# ── Email (opcional; sem SMTP os relatórios não são enviados) ──
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Marketing Intelligence Hub <reports@example.com>"

LOG_LEVEL=info

# As integrações (Google, Meta, Semrush, SMTP, Redis, APP_URL) podem ser configuradas em Integrações → Configuração;
# esses valores ficam encriptados na BD e sobrepõem-se aos deste ficheiro. 1 = usar só variáveis de ambiente e bloquear a edição.
SETTINGS_ENV_ONLY=0
