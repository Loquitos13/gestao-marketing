{
  "name": "marketing-intelligence-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Marketing Intelligence Hub — plataforma de gestão, monitorização e análise de marketing digital multi-cliente",
  "scripts": {
    "dev": "next dev -p 3100",
    "dev:up": "tsx --env-file-if-exists=.env scripts/dev-up.ts",
    "build": "next build",
    "start": "next start -p 3100",
    "worker": "tsx --env-file-if-exists=.env src/worker/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "smoke": "tsx --env-file-if-exists=.env scripts/smoke.ts",
    "agent:export": "tsx --env-file-if-exists=.env scripts/export-agent-dataset.ts",
    "agent:eval": "vitest run --config vitest.eval.config.ts",
    "integrations:verify": "tsx --env-file-if-exists=.env scripts/verify-integrations.ts",
    "load:sync": "tsx --env-file-if-exists=.env scripts/load-sync.ts",
    "db:up": "docker compose up -d postgres redis",
    "db:backup": "tsx scripts/db-backup.ts",
    "db:restore-check": "tsx scripts/db-restore.ts check",
    "db:restore": "tsx scripts/db-restore.ts apply",
    "reports:align": "tsx --env-file-if-exists=.env scripts/align-reports.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx --env-file-if-exists=.env prisma/seed.ts",
    "db:reset": "prisma migrate reset --force",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx --env-file-if-exists=.env prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@react-pdf/renderer": "^4.3.0",
    "@tanstack/react-table": "^8.21.3",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.58.0",
    "clsx": "^2.1.1",
    "exceljs": "^4.4.0",
    "ioredis": "5.11.1",
    "lucide-react": "^0.577.0",
    "next": "15.5.28",
    "next-themes": "^0.4.6",
    "nodemailer": "^10.1.1",
    "pino": "^9.9.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "^3.2.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.3.1",
    "undici": "^7.30.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.0",
    "@types/nodemailer": "^7.0.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "prisma": "6.19.3",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
